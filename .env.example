# Copie ce fichier en .env (gitignoré) pour docker compose.

# --- Fournisseur du modèle -------------------------------------------------
# Par défaut (REGISTRE_PROVIDER absent ou "anthropic") : l'API Anthropic.
ANTHROPIC_API_KEY=sk-ant-...
REGISTRE_MODEL=claude-sonnet-5

# Pour utiliser n'importe quel autre modèle via une API compatible OpenAI
# ("chat completions" — NVIDIA NIM https://build.nvidia.com/models, Together,
# Groq, un serveur vLLM local...), décommente ces trois lignes à la place des
# deux ci-dessus (REGISTRE_MODEL reste utilisé, avec le nom du modèle propre
# à cet endpoint) :
# REGISTRE_PROVIDER=compatible_openai
# REGISTRE_BASE_URL=https://integrate.api.nvidia.com/v1
# REGISTRE_API_KEY=nvapi-...
# REGISTRE_MODEL=meta/llama-3.1-405b-instruct

# Mot de passe partagé : sans lui, l'app est accessible sans authentification.
# Obligatoire dès que l'app est exposée au-delà de localhost.
REGISTRE_PASSWORD=change-moi

# À passer à true une fois l'app derrière un reverse proxy TLS (HTTPS) :
# rend le cookie de session Secure (jamais envoyé en clair).
REGISTRE_COOKIE_SECURE=false
